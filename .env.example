# Server-only. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Generate three different random secrets (at least 32 characters each).
SESSION_SECRET=
PILOT_ACCESS_CODE=
RESEARCH_EXPORT_TOKEN=
# Separate 32-byte base64 encryption key: openssl rand -base64 32
CONTACT_ENCRYPTION_KEY=
# Optional email delivery, called by a private scheduler / investigator only.
RESEND_API_KEY=
EMAIL_FROM=
# Pilot remains closed unless explicitly enabled after local setup.
PILOT_ENABLED=false
